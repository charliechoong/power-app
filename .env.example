# Local mode leaves all existing browser data untouched.
APP_STORAGE_MODE=local
# Set these in Vercel and in .env.local only when ready to connect to the cloud.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# UUID of the single account created in Supabase Auth and app_private.owners.
APP_OWNER_ID=
# Exact deployed site origin (no path). On localhost, use http://127.0.0.1:3101.
APP_URL=
